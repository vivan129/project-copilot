# ─── App ───────────────────────────────────────
APP_NAME=project-copilot
APP_ENV=development
SECRET_KEY=your-super-secret-key-change-this

# ─── Database ───────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/projectcopilot

# ─── Redis ──────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Auth ───────────────────────────────────────
JWT_SECRET=your-jwt-secret-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Anthropic (primary AI — required) ──────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-opus-4-8

# ─── OpenAI (optional — fallback) ───────────────
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o
OPENAI_MINI_MODEL=gpt-4o-mini

# ─── ChromaDB ───────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db

# ─── Stripe ─────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PRO_PRICE_ID=price_xxxxx
STRIPE_EXPERT_PRICE_ID=price_xxxxx
STRIPE_SCHOOL_PRICE_ID=price_xxxxx

# ─── Frontend ───────────────────────────────────
FRONTEND_URL=http://localhost:3000
